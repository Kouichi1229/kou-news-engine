# Kou News Engine - environment variables
# Copy this file to `.env` and adjust values as needed.
#   cp .env.example .env
# Never commit real secrets. Keep all credentials in environment variables.
#
# Every variable below is validated at startup by the Zod schema in
# `src/config/env.ts`. Invalid values for known variables fail fast.
# Unknown environment variables are silently stripped by Zod and are NOT
# rejected, so check variable names carefully. Values shown are the defaults.

# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Application timezone.
# RETAINED BUT CURRENTLY UNUSED: the one-shot ingestion CLI does not read this.
# It is kept for a future scheduler milestone (a daily briefing at 08:00 is
# planned, not implemented). Nothing runs on a timer today.
APP_TIMEZONE=Asia/Taipei

# Persistence: SQLite database file path.
#
# Relative paths resolve against the process working directory. The default
# `./data/kou-news.db` is the LOCAL DEVELOPMENT path: run from the repository
# root, it resolves to `<repo>/data/kou-news.db`, and the parent directory is
# created automatically if missing.
#
# This is NOT the container path. Docker Compose sets
# DATABASE_PATH=/app/data/kou-news.db explicitly, pointing at the mounted
# `kou-news-data` volume, and that value overrides anything in this file. Do not
# copy the container path into a local `.env`: `/app/data` does not exist on a
# development machine.
#
# An absolute path is also accepted and is used as-is.
DATABASE_PATH=./data/kou-news.db

# Graceful shutdown: how long to wait for connections to drain before forcing
# the process down. Must be smaller than the container's stop grace period
# (12s in `compose.yaml`). Range: 1000-60000. Default: 8000.
# Applies to the HTTP server (`npm start`); the one-shot ingestion CLI does not
# use it.
SHUTDOWN_TIMEOUT_MS=8000

# ── Extraction (I7-1a) ────────────────────────────────────────────────────────
# The extraction CLI (`npm run extract`) has no tunables of its own beyond what
# is already above: it reuses DATABASE_PATH and LOG_LEVEL.
#
# Deliberately NOT configurable, because each is a property of the extraction
# protocol rather than of a deployment. They live in
# `src/modules/extraction/extraction.constants.ts` and change only by code
# review:
#
#   LEASE_MS           = 180000   claim validity; must exceed worst-case attempt
#   MAX_ATTEMPTS       = 3        attempts per (article, extractor_version)
#   EXTRACTOR_VERSION  = 'v1'     bump to re-queue every stored article
#   MIN_CONTENT_LENGTH = 200      code points below which a body counts as empty
#   REQUEST_TIMEOUT_MS = 15000    per-request timeout
#   MAX_RESPONSE_BYTES = 2097152  hard response body cap
#   MAX_REDIRECTS      = 5        redirects followed, each fully re-validated
#   CONCURRENCY        = 1        articles extracted at once

# ── LLM (I7-1b) ───────────────────────────────────────────────────────────────
# Which adapter the provider factory builds: fake | gemini
# `fake` is the default so nothing contacts a vendor unless an operator opts in.
# A `fake` deployment needs no credential and no vendor account.
LLM_PROVIDER=fake

# Logical model name. The vendor adapter maps it to a concrete vendor model id;
# business code only ever sees this name. Range: min 1 char. Default: default.
LLM_MODEL=default

# Provider-level default timeout for one LLM call, in milliseconds.
# A per-call request may override it. Range: 1000-120000. Default: 30000.
LLM_TIMEOUT_MS=30000

# Seeds each request's output-token budget. This is a runtime default, not a
# provider setting: a caller may pass a different cap per request. The provider
# factory never reads it. Range: 1-32768. Default: 2048.
LLM_MAX_OUTPUT_TOKENS=2048

# Gemini credential. OPTIONAL: it is deliberately not required for the process to
# start, so the server and both CLIs boot with this unset. It is validated only
# when the factory actually builds a Gemini provider, i.e. when
# LLM_PROVIDER=gemini. Leave it unset for `fake`.
# Never commit a real key. The value is never logged and never appears in an
# error message.
# GEMINI_API_KEY=
